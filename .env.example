# Copy to .env.local and adjust as needed. All values are optional.
#
# VITE_FIRESTORE_DATABASE_ID: target a named Firestore database instead of the
# project's "(default)" one. Leave unset unless you deliberately created a named
# database — pointing at a database that does not exist makes every read and
# write fail with NOT_FOUND.
# VITE_FIRESTORE_DATABASE_ID=""

# PORT: port for `npm run dev` and `npm run preview`. Defaults to 3000 / 4173.
# PORT=3000
